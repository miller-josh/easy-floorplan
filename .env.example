# Supabase — Settings → API (stores the floor plans)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Clerk — Dashboard → API Keys (handles sign in / users)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your-clerk-publishable-key

# Layout Board (Neon) — server side only, set in Vercel env vars (NOT prefixed with VITE_)
# Neon dashboard -> Connect -> connection string
DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require
# Clerk dashboard -> API Keys -> Secret key (verifies sign-in tokens in /api/board)
CLERK_SECRET_KEY=sk_test_your-clerk-secret-key
